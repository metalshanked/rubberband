{
  "apps": [
    {
      "id": "dashbuilder",
      "name": "Elastic Dashbuilder",
      "description": "Build, preview, import, and export Kibana dashboards with MCP Apps.",
      "role": "domain",
      "capabilities": ["ui", "renderer", "elastic", "kibana", "dashboard"],
      "source": {
        "type": "git",
        "url": "https://github.com/elastic/example-mcp-dashbuilder.git",
        "ref": "ea9deeacfa07483f8f04e9bf6204c5e44fdba9b0"
      },
      "install": [
        ["npm", "install"],
        ["npm", "run", "build"]
      ],
      "transport": {
        "type": "stdio",
        "command": "npm",
        "args": ["run", "start"],
        "cwd": "${appDir}"
      },
      "envPassthrough": [
        "ELASTICSEARCH_URL",
        "ELASTICSEARCH_CLOUD_ID",
        "ELASTICSEARCH_API_KEY",
        "ELASTICSEARCH_USERNAME",
        "ELASTICSEARCH_PASSWORD",
        "ELASTIC_CCS_SEARCH_BY_DEFAULT",
        "ELASTIC_CCS_INDEX_PATTERNS",
        "ELASTIC_CCS_RESOLVE_TIMEOUT_MS",
        "KIBANA_URL",
        "KIBANA_SPACE_ID",
        "KIBANA_API_KEY",
        "KIBANA_USERNAME",
        "KIBANA_PASSWORD",
        "NODE_TLS_REJECT_UNAUTHORIZED"
      ]
    },
    {
      "id": "security",
      "name": "Elastic Security",
      "description": "Interactive SOC workflows for alerts, cases, rules, threat hunting, and sample ECS security data.",
      "role": "domain",
      "capabilities": ["ui", "elastic", "security", "workflow"],
      "source": {
        "type": "git",
        "url": "https://github.com/elastic/example-mcp-app-security.git",
        "ref": "18f450cd3a71bff0d76fa9a76fcefbef75673519"
      },
      "install": [
        ["npm", "install"],
        ["npm", "run", "build"]
      ],
      "transport": {
        "type": "stdio",
        "command": "npm",
        "args": ["run", "start:stdio"],
        "cwd": "${appDir}"
      },
      "envPassthrough": [
        "ELASTICSEARCH_URL",
        "ELASTICSEARCH_CLOUD_ID",
        "ELASTICSEARCH_API_KEY",
        "ELASTICSEARCH_USERNAME",
        "ELASTICSEARCH_PASSWORD",
        "ELASTIC_CCS_SEARCH_BY_DEFAULT",
        "ELASTIC_CCS_INDEX_PATTERNS",
        "ELASTIC_CCS_RESOLVE_TIMEOUT_MS",
        "CLUSTERS_JSON",
        "CLUSTERS_FILE",
        "KIBANA_URL",
        "KIBANA_SPACE_ID",
        "KIBANA_API_KEY",
        "KIBANA_USERNAME",
        "KIBANA_PASSWORD",
        "NODE_TLS_REJECT_UNAUTHORIZED"
      ]
    },
    {
      "id": "observability",
      "name": "Elastic Observability",
      "description": "Interactive SRE workflows for observability, APM, Kubernetes, ML anomalies, and alert rules.",
      "role": "domain",
      "capabilities": ["ui", "elastic", "observability", "workflow"],
      "source": {
        "type": "git",
        "url": "https://github.com/elastic/example-mcp-app-observability.git",
        "ref": "635661a19245962fbab27095b0e90ec8fbcc2048"
      },
      "install": [
        ["npm", "install"],
        ["npm", "run", "build"]
      ],
      "skillPacks": [
        {
          "name": "apm-health-summary.zip",
          "url": "https://github.com/elastic/example-mcp-app-observability/releases/download/v1.3.1/apm-health-summary.zip",
          "sha256": "5169d2e11d96ce9a40bef8a2540143628ca6a47b74e99e628c67fc910676e9bb"
        },
        {
          "name": "apm-service-dependencies.zip",
          "url": "https://github.com/elastic/example-mcp-app-observability/releases/download/v1.3.1/apm-service-dependencies.zip",
          "sha256": "e3cc02c486fbaf6f30eb1c125df8af26cbef6def43e7dc4d920ef34c21ba8b7f"
        },
        {
          "name": "k8s-blast-radius.zip",
          "url": "https://github.com/elastic/example-mcp-app-observability/releases/download/v1.3.1/k8s-blast-radius.zip",
          "sha256": "1416ed66fcabc45c6357284d22e733dec2756ede0279a5ec083e9fc5ab1cc3fd"
        },
        {
          "name": "manage-alerts.zip",
          "url": "https://github.com/elastic/example-mcp-app-observability/releases/download/v1.3.1/manage-alerts.zip",
          "sha256": "a85c9f3ce5be93c989ec2b8b9076a83acce1b7ba97e6edd1e9e9e25138340e37"
        },
        {
          "name": "ml-anomalies.zip",
          "url": "https://github.com/elastic/example-mcp-app-observability/releases/download/v1.3.1/ml-anomalies.zip",
          "sha256": "086c2e7d17b96c220e08db724666f87ab4c1056571241132c9e5a2ccbcc7e64d"
        },
        {
          "name": "observe.zip",
          "url": "https://github.com/elastic/example-mcp-app-observability/releases/download/v1.3.1/observe.zip",
          "sha256": "1c625bddd363649ece5469e256705b0dbf373d39056f7d4a243e40e239a9dbc4"
        }
      ],
      "transport": {
        "type": "stdio",
        "command": "npm",
        "args": ["run", "start:stdio"],
        "cwd": "${appDir}"
      },
      "envPassthrough": [
        "ELASTICSEARCH_URL",
        "ELASTICSEARCH_CLOUD_ID",
        "ELASTICSEARCH_API_KEY",
        "ELASTICSEARCH_USERNAME",
        "ELASTICSEARCH_PASSWORD",
        "ELASTIC_CCS_SEARCH_BY_DEFAULT",
        "ELASTIC_CCS_INDEX_PATTERNS",
        "ELASTIC_CCS_RESOLVE_TIMEOUT_MS",
        "CLUSTERS_JSON",
        "CLUSTERS_FILE",
        "KIBANA_URL",
        "KIBANA_SPACE_ID",
        "KIBANA_API_KEY",
        "KIBANA_USERNAME",
        "KIBANA_PASSWORD",
        "NODE_TLS_REJECT_UNAUTHORIZED"
      ]
    },
    {
      "id": "mcp-app-trino",
      "name": "Trino Visualization",
      "description": "Query Trino or Starburst and render MCP App visualizations or multi-panel dashboards with Elastic Charts.",
      "role": "source",
      "capabilities": ["ui", "source", "trino", "starburst", "sql", "visualization"],
      "source": {
        "type": "git",
        "url": "https://github.com/metalshanked/mcp-app-trino.git",
        "ref": "f1a0d082f116085e324bf45779c14e3e96db5319"
      },
      "install": [
        ["npm", "install"],
        ["npm", "run", "build"]
      ],
      "transport": {
        "type": "stdio",
        "command": "npm",
        "args": ["run", "start:stdio"],
        "cwd": "${appDir}"
      },
      "envPassthrough": [
        "TRINO_HOST",
        "TRINO_PORT",
        "TRINO_SCHEME",
        "TRINO_SSL",
        "TRINO_USER",
        "TRINO_PASSWORD",
        "TRINO_ACCESS_TOKEN",
        "TRINO_AUTH_TYPE",
        "TRINO_CATALOG",
        "TRINO_SCHEMA",
        "TRINO_SOURCE",
        "TRINO_INSECURE_TLS",
        "TRINO_TLS_INSECURE",
        "TRINO_CA_CERT",
        "TRINO_CA_CERT_FILE",
        "TRINO_TLS_CA_CERT",
        "TRINO_TLS_CA_CERT_FILE",
        "TRINO_CLIENT_CERT",
        "TRINO_CLIENT_CERT_FILE",
        "TRINO_CLIENT_KEY",
        "TRINO_CLIENT_KEY_FILE",
        "TRINO_CLIENT_KEY_PASSPHRASE",
        "TRINO_TLS_CLIENT_CERT",
        "TRINO_TLS_CLIENT_CERT_FILE",
        "TRINO_TLS_CLIENT_KEY",
        "TRINO_TLS_CLIENT_KEY_FILE",
        "TRINO_TLS_CLIENT_KEY_PASSPHRASE",
        "STARBURST_HOST",
        "STARBURST_PORT",
        "STARBURST_SCHEME",
        "STARBURST_USER",
        "STARBURST_PASSWORD",
        "STARBURST_ACCESS_TOKEN",
        "STARBURST_CATALOG",
        "STARBURST_SCHEMA",
        "STARBURST_INSECURE_TLS",
        "STARBURST_TLS_INSECURE",
        "STARBURST_CA_CERT",
        "STARBURST_CA_CERT_FILE",
        "STARBURST_TLS_CA_CERT",
        "STARBURST_TLS_CA_CERT_FILE",
        "STARBURST_CLIENT_CERT",
        "STARBURST_CLIENT_CERT_FILE",
        "STARBURST_CLIENT_KEY",
        "STARBURST_CLIENT_KEY_FILE",
        "STARBURST_CLIENT_KEY_PASSPHRASE",
        "STARBURST_TLS_CLIENT_CERT",
        "STARBURST_TLS_CLIENT_CERT_FILE",
        "STARBURST_TLS_CLIENT_KEY",
        "STARBURST_TLS_CLIENT_KEY_FILE",
        "STARBURST_TLS_CLIENT_KEY_PASSPHRASE",
        "NODE_TLS_REJECT_UNAUTHORIZED"
      ]
    },
    {
      "id": "data-analytics",
      "name": "Data Analytics",
      "description": "OpenAI Data Analytics skills and MCP widgets for source-backed charts, tables, reports, dashboards, and artifact validation.",
      "role": "renderer",
      "capabilities": ["ui", "renderer", "analytics", "skills", "reports", "dashboards", "charts", "tables"],
      "source": {
        "type": "git",
        "url": "https://github.com/openai/role-specific-plugins.git",
        "ref": "ebf5795abb95c18ee17e90bc56c83820d998eecd",
        "subdirectory": "plugins/data-analytics"
      },
      "transport": {
        "type": "stdio",
        "command": "node",
        "args": ["./mcp/server.cjs", "--stdio"],
        "cwd": "${appDir}"
      },
      "envPassthrough": [
        "NODE_TLS_REJECT_UNAUTHORIZED"
      ]
    }
  ]
}
